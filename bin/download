#!/bin/bash
# Program:     download
# Author:      Oskar Voldbakken Hesle
# Date:        2026-08-12

set -euo pipefail

if [[ $# -ne 1 || ! $1 =~ ^(linux|macos|test)$ ]]; then
	printf "\x1b[1;33musage: %s <linux|macos>\x1b\n" "$0"
	exit 1
fi

system_type="$1"
find . -mindepth 1 ! -name "$(basename "$0")" -exec rm -rf -- {} +

function linux {
	local linux="nvim-linux-x86_64"
	wget -q "https://github.com/neovim/neovim/releases/download/stable/$linux.tar.gz"
	mkdir linux && tar -xzf "$linux.tar.gz" --strip-components=1 -C linux
	rm -f "$linux.tar.gz"
}

function macos {
	local macos="nvim-macos-arm64"
	wget -q "https://github.com/neovim/neovim/releases/download/stable/$macos.tar.gz"
	mkdir macos && tar -xzf "$macos.tar.gz" --strip-components=1 -C macos
}

case "$1" in
	linux)
		linux
		;;
	macos)
		macos
		;;
esac
exit 0
